  "purchaseErrorInvalidSubscriberAttributesError": "வாங்குதல் தோல்வியடைந்தது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும். சிக்கல் தீர்க்கப்படவில்லை என்றால், அமைப்புகள் > தொடர்பு கொள்ளுதல் மூலம் எங்களை தொடர்பு கொள்ளவும். விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorLogOutWithAnonymousUserError": "பயனர் தகவலை பெறுவதில் தோல்வியடைந்தது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும். சிக்கல் தீராவிட்டால் அமைப்புகள் > தொடர்பு கொள்ளுங்கள் மூலம் தொடர்பு கொள்ளுங்கள். விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorConfigurationError": "வாங்குதல் தகவல் பெறுவதில் தோல்வி. சிறிது நேரம் கழித்து மீண்டும் முயற்சி செய்யுங்கள். சரி செய்யப்படாவிட்டால் அமைப்புகள் > தொடர்பு கொள்ளுங்கள் மூலம் தொடர்பு கொள்ளுங்கள். விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorUnsupportedError": "அறியப்படாத பிழை ஏற்பட்டுள்ளது. சமீபத்திய பதிப்பிற்கு புதுப்பித்து மீண்டும் முயற்சி செய்யவும். பிரச்சனை தீரவில்லை எனில் அமைப்புகள் > தொடர்பு கொள்ளுதல் வழியாக எங்களை தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorEmptySubscriberAttributesError": "காரணம் தெரியாத பிழை. வாங்கும் தகவலை முன்கூட்டியே பெற முடியவில்லை. விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorProductDiscountMissingIdentifierError": "காரணம் தெரியாத பிழை. சமீபத்திய பதிப்பிற்கு புதுப்பித்து மீண்டும் முயற்சிக்கவும். தீர்க்கப்படாவிட்டால் அமைப்புகள் > தொடர்பு மூலம் தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorUnknownNonNativeError": "அறியப்படாத காரணத்தால் ஏற்பட்ட பிழை. சமீபத்திய பதிப்புக்கு புதுப்பித்து மீண்டும் முயற்சிக்கவும். தீர்க்கப்படாவிட்டால் அமைப்புகள் > விசாரணை மூலம் தொடர்பு கொள்ளுங்கள். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorProductDiscountMissingSubscriptionGroupIdentifierError": "அறியப்படாத பிழை ஏற்பட்டுள்ளது. சமீபத்திய பதிப்பிற்கு புதுப்பித்து மீண்டும் முயற்சிக்கவும். பிரச்சனை தீராவிட்டால் அமைப்புகள் > தொடர்புகொள்ளுங்கள் மூலம் தொடர்புகொள்ளுங்கள். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorCustomerInfoError": "வாடிக்கையாளர் தகவல் பெறுதல் தோல்வியடைந்தது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும். தீர்க்கப்படவில்லையென்றால் அமைப்புகள் > தொடர்பு வழியாக தொடர்பு கொள்ளவும். விபரம்: குறியீடு: {errorCode} {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorSystemInfoError": "சாதனத்தின் அமைப்புகளில் சிக்கல் உள்ளது. சரிபார்த்து மீண்டும் முயற்சிக்கவும். இது தீர்க்கப்படவில்லை என்றால் அமைப்புகள் > தொடர்பு கொள்ளுங்கள் மூலம் தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorBeginRefundRequestError": "திரும்பக் கொடுப்பு செயல்முறை தொடங்கப்பட்டுள்ளது. தயவுசெய்து உறுதிப்படுத்திய பின் மீண்டும் முயற்சிசெய்யவும். சமாധானமாகாவிட்டால் அமைப்புகள் > விசாரணை மூலம் தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorProductRequestTimeout": "நேரம் முடிந்துவிட்டது. தங்களின் இணைப்பு சூழலை சரிபார்த்து மீண்டும் முயற்சி செய்யவும். சரியாகவில்லை எனில் அமைப்புகள் > விசாரணை மூலம் தொடர்பு கொள்ளவும். விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorApiEndpointBlocked": "தெரியாத பிழை ஏற்பட்டுள்ளது. சமீபத்திய பதிப்பிற்கு புதுப்பித்து மீண்டும் முயற்சிக்கவும். தீர்வு கிடைக்காவிட்டால், அமைப்புகள் > தொடர்பு வழியாக எங்களை தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorInvalidPromotionalOfferError": "அறியப்படாத பிழை ஏற்பட்டுள்ளது. சமீபத்திய பதிப்பிற்கு புதுப்பித்து மீண்டும் முயற்சிக்கவும். தீர்வு கிடைக்காத பட்சத்தில் அமைப்புகள் > விசாரணை வழியாக தொடர்பு கொள்ளவும். குறியீடு: {errorCode} விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
  "purchaseErrorOfflineConnectionError": "இணைப்பு பிரச்சினை. உங்கள் இணைய இணைப்பை சரிபார்த்து மீண்டும் முயற்சிக்கவும். சிக்கல் தீராவிட்டால், அமைப்புகள் > தொடர்பு கொள்ள வழியாக எங்களைத் தொடர்பு கொள்ளவும். விவரங்கள்: {exceptionMessage}:{exceptionDetails}",
