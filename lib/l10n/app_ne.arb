  "reminderNotificationCustomizeWordFeatureAppealBody": "मानक \"पिल खाने समय भयो\" लाई तपाईंले मन पर्ने शब्दमा अनुकूलित गर्न सकिन्छ। उत्प्रेरक शब्दहरू, आफ्नो पाल्तु जनावरको नाम, वा दैनिक सेवन झन् रमाइलो बनाउने कुनै पनि वाक्यांशमा परिवर्तन गरेर हेर्नुस्।",
  "appearanceModeDateFeatureAppealTitle": "पिल शिटमा मिति देखाउनुहोस्",
  "appearanceModeDateFeatureAppealShortDescription": "एक नजरमा कहिले खाने हो जाँच्नुहोस्",
  "appearanceModeDateFeatureAppealHeadline": "पिल शीटमा मिति देखाउन सकिन्छ",
  "appearanceModeDateFeatureAppealBody": "पिल शिटका खानाहरूमा मिति देखाउँदा, विगतको औषधि सेवन इतिहास र भविष्यको सेवन तालिका एकै नजरमा जाँच गर्न सकिन्छ। \"नम्बर\" मोड र \"मिति\" मोड बीच स्विच गरेर, आफ्नो सुविधा अनुसारको प्रदर्शन छान्नुहोस्।",
  "recordPillFeatureAppealTitle": "सेवन इतिहास सजिलै हेर्नुहोस्",
  "recordPillFeatureAppealShortDescription": "कहिले सेवन गर्नुभयो तुरुन्त थाहा पाउनुस्",
  "recordPillFeatureAppealHeadline": "होम स्क्रिनमा पिल सेवन रेकर्ड गर्नुहोस्",
  "recordPillFeatureAppealBody": "होम स्क्रिनमा रहेको पिल सिटलाई ट्याप गर्नु मात्रले त्यस दिनको सेवन रेकर्ड गर्न सकिन्छ। गलतीले रेकर्ड भएमा पनि, फेरि एक पटक ट्याप गरेर रद्द गर्न सकिन्छ। सेवन इतिहास पछि पनि हेर्न सकिने भएकाले, निश्चिन्त भएर जारी राख्न सकिन्छ।",
  "menstruationFeatureAppealTitle": "महिनावारी रेकर्ड र पूर्वानुमान",
  "menstruationFeatureAppealShortDescription": "महिनावारी शुरू मिति रेकर्ड गरी चक्र बुझ्नुहोस्",
  "menstruationFeatureAppealHeadline": "महिनावारीको रेकर्ड र पूर्वानुमान गर्न सकिन्छ",
  "menstruationFeatureAppealBody": "महिनावारी आएपछि मात्र रेकर्ड गर्नुहोस्, र विगतको महिनावारी इतिहास सूचीमा हेर्न सकिन्छ। अर्को महिनावारीको अनुमानित मिति पनि स्वचालित रूपमा पूर्वानुमान गरिन्छ, त्यसैले तपाईं योजनाबद्ध तरिकाले समय बिताउन सक्नुहुन्छ।",
  "calendarDiaryFeatureAppealTitle": "क्यालेन्डरमा स्वास्थ्य स्थिति रेकर्ड गर्नुहोस्",
  "calendarDiaryFeatureAppealShortDescription": "हरेक दिनको स्वास्थ्य अवस्था क्यालेन्डरमा राखौं",
  "calendarDiaryFeatureAppealHeadline": "दैनिक स्वास्थ्य स्थिति क्यालेन्डरमा रेकर्ड गर्नुहोस्",
  "calendarDiaryFeatureAppealBody": "क्यालेन्डरबाट मिति ट्याप गरेर शारीरिक अवस्था, मनस्थिति, लक्षण आदि रेकर्ड गर्न सकिन्छ। सेवन रेकर्ड र महिनावारी रेकर्डसँगै हेर्न सकिने भएकाले आफ्नो शरीरको लय बुझ्न सकिन्छ।",
  "futureScheduleFeatureAppealTitle": "भविष्यको योजना लेखौं",
  "futureScheduleFeatureAppealShortDescription": "अस्पताल भ्रमण जस्ता भविष्यका तालिकाहरू व्यवस्थापन गर्नुहोस्",
  "futureScheduleFeatureAppealHeadline": "क्यालेन्डरमा भविष्यका योजनाहरू रेकर्ड गर्नुहोस्",
  "futureScheduleFeatureAppealBody": "डाक्टरको भेट, यात्राको योजना लगायत भविष्यका कार्यक्रमहरू क्यालेन्डरमा लेख्न सकिन्छ। चक्कीको सेवन चक्रसँगै जाँच गर्न सकिने भएकाले, महिनावारीको कार्यक्रम पनि ध्यानमा राखेर योजना बनाउन सकिन्छ।",
  "healthCareIntegrationFeatureAppealTitle": "स्वास्थ्य सेवासँग जडान",
  "healthCareIntegrationFeatureAppealShortDescription": "मासिक धर्म रेकर्ड स्वास्थ्य सेवासँग साझा गर्नुहोस्",
  "healthCareIntegrationFeatureAppealHeadline": "स्वास्थ्य सेवासँग जोड्न सकिन्छ",
  "healthCareIntegrationFeatureAppealBody": "Pilllमा रेकर्ड गरिएको महिनावारी डेटा स्वास्थ्य एपसँग स्वचालित रूपमा जोड्न सकिन्छ। स्वास्थ्य एपमा रहेका अन्य स्वास्थ्य डेटासँगै हेर्न सकिनुहुन्छ र अन्य एपहरूमा पनि महिनावारी डेटा प्रयोग गर्न सकिन्छ।",
  "quickRecordFeatureAppealTitle": "सूचनाबाट सिधै सेवन रेकर्ड",
  "quickRecordFeatureAppealShortDescription": "एप नखोलिकन सूचनामै रेकर्ड गर्नुहोस्",
  "quickRecordFeatureAppealHeadline": "सूचना स्क्रिनमा एक ट्यापले सेवन रेकर्ड",
  "quickRecordFeatureAppealBody": "रिमाइन्डर सूचनालाई लामो थिच्नुहोस् भने 'सेवन गरियो' को कार्य देखिन्छ, र एप नखोलीकन सेवन रेकर्ड गर्न सकिन्छ।",
  "creatingNewPillSheetFeatureAppealTitle": "पिल सिट स्वतः थप्नुहोस्",
  "creatingNewPillSheetFeatureAppealShortDescription": "अर्को सिट स्वतः सिर्जना गर्नुहोस्",
  "creatingNewPillSheetFeatureAppealHeadline": "अर्को पिल शिट स्वचालित रूपमा सिर्जना गर्नुहोस्",
  "creatingNewPillSheetFeatureAppealBody": "हालको पिल शीट समूह समाप्त भएपछि, नयाँ पिल शीट समूह स्वचालित रूपमा सिर्जना हुन्छ। म्यानुअल रूपमा स्विच गर्ने आवश्यकता पर्दैन र रेकर्डमा कुनै खाली ठाउँ हुँदैन।",
  "alarmKitFeatureAppealTitle": "अलार्म घडीजस्तै बज्ने अलार्म",
  "alarmKitFeatureAppealShortDescription": "साइलेन्टमा पनि निश्चित रूपमा बज्ने सूचना",
  "alarmKitFeatureAppealHeadline": "अलार्म घडी जस्तै औषधि सेवन अलार्म",
  "alarmKitFeatureAppealBody": "iOS 26 वा पछिको संस्करणमा उपलब्ध AlarmKit प्रयोग गरी, साइलेन्ट मोड वा फोकस मोडमा पनि निश्चित रूपमा बज्ने अलार्मले पिल सेवनको समय सूचित गर्दछ।",
  "todayPillNumberFeatureAppealTitle": "आजको खुराक नम्बर मिलाउनुहोस्",
  "todayPillNumberFeatureAppealShortDescription": "नम्बर गलत भएमा सेटिङमा सच्याउनुहोस्",
  "todayPillNumberFeatureAppealHeadline": "आज खाने चक्कीको नम्बर परिवर्तन गर्न सकिन्छ",
  "todayPillNumberFeatureAppealBody": "पिल खान बिर्सिएमा वा गलत पिल खाइयो भने पिल शीटको नम्बर र वास्तविक सेवनमा भिन्नता आउँदा, आज खानुपर्ने पिल नम्बर हातले मिलाउन सकिन्छ। गृहपृष्ठको पिल नम्बर प्रदर्शनबाट पनि उही स्क्रिन खोल्न सकिन्छ।",
  "restDurationFeatureAppealTitle": "गोली नखाने अवधि रेकर्ड गर्नुहोस्",
  "restDurationFeatureAppealShortDescription": "विराम र अवरोधको सटीक व्यवस्थापन",
  "restDurationFeatureAppealHeadline": "पिल सेवन बिराम गर्ने",
  "restDurationFeatureAppealBody": "तपाईंले पिल शिटमा केही समयका लागि पिल खान बन्द गर्ने अवधि रेकर्ड गर्न सक्नुहुन्छ। बिदाको समयमा सेवन नम्बर अघि बढ्दैन, र पुनः सुरु गर्दा तुरुन्त रेकर्ड जारी राख्न सकिन्छ।",
