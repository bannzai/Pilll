abstract class Secret {
  // RevenueCat の Public app-specific API key はアプリ (App Store / Play Store) ごとに発行されるため、プラットフォーム別に持つ
  static const revenueCatPublicAPIKeyIOS = "[REVENUECAT_PUBLIC_API_KEY_IOS]";
  static const revenueCatPublicAPIKeyAndroid = "[REVENUECAT_PUBLIC_API_KEY_ANDROID]";
  static const iOSAdmobNativeAdvanceIdentifier = "[IOS_ADMOB_NATIVE_ADVANCE_IDENTIFIER]";
  static const androidAdmobNativeAdvanceIdentifier = "[ANDROID_ADMOB_NATIVE_ADVANCE_IDENTIFIER]";
  static const iOSAdmobBannerIdentifier = "[IOS_ADMOB_BANNER_IDENTIFIER]";
  static const androidAdmobBannerIdentifier = "[ANDROID_ADMOB_BANNER_IDENTIFIER]";
}
