# 1Password secret references: op run --env-file .env.1password -- <command> が環境変数として渡す。
# 値は書かない。op://<vault>/<item>/<field> の参照だけを書く。
ANDROID_KEYSTORE_ALIAS=op://pilll/ANDROID_KEYSTORE_ALIAS/password
ANDROID_KEYSTORE_PASSWORD=op://pilll/ANDROID_KEYSTORE_PASSWORD/password
ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD=op://pilll/ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD/password
APP_STORE_API_KEY_CONTENT=op://pilll/APP_STORE_API_KEY_CONTENT/password
APP_STORE_API_KEY_ID=op://pilll/APP_STORE_API_KEY_ID/password
APPLE_APP_PASSWORD=op://pilll/APPLE_APP_PASSWORD/password
